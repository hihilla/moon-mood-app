# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# freeastrologyapi.com — from your account dashboard after signup
# Server-side only, never exposed to the browser (no NEXT_PUBLIC_ prefix)
FREE_ASTROLOGY_API_KEY=your-api-key
